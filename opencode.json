{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp" }
  },
  "formatter": {
    "oxfmt-repo": { "command": ["bun", "x", "oxfmt", "$FILE"], "extensions": [".ts", ".tsx"] }
  },
  "permission": {
    "edit": {
      "*": "allow",
      ".opencode/plugin/*": "deny",
      ".opencode/logs/*": "deny",
      "apps/web/src/atomic/*": "ask"
    },
    "bash": {
      "*": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git reset *": "ask",
      "git clean *": "deny",
      "rm *": "ask"
    },
    "skill": "deny"
  }
}
